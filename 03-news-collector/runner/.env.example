# 로컬 러너 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋 금지)
# 실행: node --env-file=.env summarize.mjs daily

# Apps Script Web App 배포 URL (게시 > 웹 앱으로 배포에서 얻는 .../exec 주소)
WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Web App 인증 토큰 — Apps Script 스크립트 속성 WEBAPP_TOKEN 과 동일한 값
WEBAPP_TOKEN=

# 사내 LiteLLM 게이트웨이 API 키
LITELLM_KEY=

# (선택) 게이트웨이 URL / 모델 — 기본값이 있으니 필요할 때만 지정
# LITELLM_URL=https://litellm.ops.raonops.com
# MODEL=claude-sonnet-4-6
